@{
    ViewData["Title"] = "Pomodoro";
}

<section class="timer-card card-surface" id="pomodoro" data-mode="focus">
    <div class="timer-top">
        <div class="segmented" role="group" aria-label="Mode">
            <button type="button" data-mode-btn="focus" class="active">Focus</button>
            <button type="button" data-mode-btn="short">Short break</button>
            <button type="button" data-mode-btn="long">Long break</button>
        </div>
        <button type="button" class="icon-btn" id="pomodoro-expand" title="Full screen (F)" aria-label="Expand timer to full screen">
            <svg class="icon icon-expand" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" /></svg>
            <svg class="icon icon-compress" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3" /></svg>
        </button>
    </div>

    <div class="ring">
        <svg viewBox="0 0 200 200" aria-hidden="true">
            <circle class="ring-track" cx="100" cy="100" r="90" />
            <circle class="ring-bar" id="pomodoro-bar" cx="100" cy="100" r="90" pathLength="100" />
        </svg>
        <div class="ring-center">
            <div class="ring-time" id="pomodoro-time" role="timer" aria-live="off">25:00</div>
            <div class="ring-label" id="pomodoro-label">Focus</div>
        </div>
    </div>

    <div class="controls">
        <button type="button" class="icon-btn" id="pomodoro-reset" title="Reset (R)" aria-label="Reset">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" /></svg>
        </button>
        <button type="button" class="btn btn-primary btn-main" id="pomodoro-start" title="Start / pause (Space)" aria-label="Start">
            <svg class="icon icon-play" viewBox="0 0 24 24" aria-hidden="true"><polygon class="solid" points="7 4 20 12 7 20 7 4" /></svg>
            <svg class="icon icon-pause" viewBox="0 0 24 24" aria-hidden="true"><rect class="solid" x="6" y="4" width="4" height="16" rx="1" /><rect class="solid" x="14" y="4" width="4" height="16" rx="1" /></svg>
        </button>
        <button type="button" class="icon-btn" id="pomodoro-skip" title="Skip" aria-label="Skip">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><polygon points="5 4 15 12 5 20 5 4" /><line x1="19" y1="5" x2="19" y2="19" /></svg>
        </button>
    </div>

    <div class="pips" id="pomodoro-pips" title="Sessions until the next long break">
        <span class="pip"></span><span class="pip"></span><span class="pip"></span><span class="pip"></span>
    </div>
</section>

<details class="settings card-surface">
    <summary>Durations (minutes)</summary>
    <div class="row g-3 mt-1">
        <div class="col-4">
            <label class="form-label small text-muted" for="set-focus">Focus</label>
            <input type="number" min="1" max="180" class="form-control" id="set-focus" />
        </div>
        <div class="col-4">
            <label class="form-label small text-muted" for="set-short">Short break</label>
            <input type="number" min="1" max="60" class="form-control" id="set-short" />
        </div>
        <div class="col-4">
            <label class="form-label small text-muted" for="set-long">Long break</label>
            <input type="number" min="1" max="90" class="form-control" id="set-long" />
        </div>
    </div>
</details>

<section class="history card-surface">
    <h2 class="h5 mb-3">Your progress</h2>
    <div class="stat-tiles">
        <div class="stat"><div class="stat-value" id="stat-today">0</div><div class="stat-label">Today</div></div>
        <div class="stat"><div class="stat-value" id="stat-streak">0</div><div class="stat-label">Day streak</div></div>
        <div class="stat"><div class="stat-value" id="stat-year">0</div><div class="stat-label" id="stat-year-label">Last 12 months</div></div>
    </div>
    <div class="cal-scroll">
        <div class="cal-months" id="cal-months"></div>
        <div class="cal-grid" id="cal-grid"></div>
    </div>
    <div class="cal-legend">
        Less
        <span class="cal-cell" data-level="0"></span>
        <span class="cal-cell" data-level="1"></span>
        <span class="cal-cell" data-level="2"></span>
        <span class="cal-cell" data-level="3"></span>
        <span class="cal-cell" data-level="4"></span>
        More
    </div>
</section>

@section Scripts {
    <script src="~/js/pomodoro.js" asp-append-version="true"></script>
}
